{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "actual-mcp",
  "main": "cloudflare/worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "ActualMcpContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic",
      "scheduling_policy": "regional",
      "constraints": {
        "regions": ["WEUR"],
        "jurisdiction": "eu",
      },
      "rollout_step_percentage": 100,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTUAL_MCP_CONTAINER",
        "class_name": "ActualMcpContainer",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ActualMcpContainer"],
    },
  ],
  "vars": {
    "ACTUAL_SYNC_TTL_MS": "60000",
  },
  "secrets": {
    "required": ["ACTUAL_BUDGET_SYNC_ID", "ACTUAL_PASSWORD", "ACTUAL_SERVER_URL", "BEARER_TOKEN"],
  },
  "observability": {
    "enabled": true,
  },
}
